# Copy to .env.development (or .env.local) and fill in real values.
# VITE_* values are embedded in the client bundle; never put secrets here.
VITE_API_URL=http://localhost:8787
VITE_APP_ENV=dev

# Log adapter: console | file. Default: console in dev, file otherwise.
# Set to file to exercise the rotating file logger during tauri dev.
# VITE_LOG_TARGET=file

# Optional vendor keys (leave unset until the matching milestone).
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# Skip all PostHog requests until telemetry consent is granted. Privacy-first
# default is true. Set false only if kill switches must reach users who have
# not consented (anonymous evaluation then contacts PostHog).
# VITE_FLAGS_REQUIRE_CONSENT=true
# VITE_SENTRY_DSN=
# Release version reported to Sentry (default 0.1.0)
# VITE_APP_VERSION=0.1.0
# Where "Report a problem" sends the redacted log bundle.
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_SUPPORT_URL=https://example.com/support
# Public keys for offline entitlement verification (JSON array of {kid, jwk}).
# VITE_ENTITLEMENT_PUBLIC_KEYS=[]
