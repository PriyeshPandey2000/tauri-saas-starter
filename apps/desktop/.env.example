# Copy to .env.development (or .env.local) and fill in real values.
# VITE_* values are embedded in the client bundle; never put secrets here.
VITE_API_URL=http://localhost:8787
VITE_APP_ENV=dev

# Log adapter: console | file. Default: console in dev, file otherwise.
# Set to file to exercise the rotating file logger during tauri dev.
# VITE_LOG_TARGET=file

# Optional vendor keys (leave unset until the matching milestone).
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_SENTRY_DSN=
