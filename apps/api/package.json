{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.7",
    "@app/shared": "workspace:*"
  },
  "devDependencies": {
    "@config/eslint-config": "workspace:*",
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.5"
