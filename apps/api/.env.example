# API configuration. Copy to apps/api/.env and fill in real values.
PORT=8787

# Pooled runtime connection (host-agnostic; Neon, Supabase, local Postgres, ...).
DATABASE_URL=postgres://user:password@localhost:5433/app
# Unpooled connection, used only by drizzle-kit migrations.
DATABASE_URL_DIRECT=postgres://user:password@localhost:5433/app
DATABASE_POOL_MAX=5

# 32+ characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this API (Better Auth issuer/audience).
BETTER_AUTH_URL=http://localhost:8787

# Google Cloud OAuth client (see docs/auth-setup.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deep-link scheme used by the desktop app. Keep in sync with
# apps/desktop/src/shared/lib/app-links.ts and src-tauri/tauri.conf.json.
APP_DEEP_LINK_SCHEME=tauri-saas-starter

# Require email verification before sign-in. "true" | "false"
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Optional comma-separated extra CORS origins. Tauri origins are always allowed.
# CORS_ORIGINS=

TRUSTED_PROXY_HEADER=
# Header set by the trusted proxy in front of the API (e.g. fly-client-ip, x-forwarded-for, cf-connecting-ip).
# Leave unset to key rate limits on the socket address. x-forwarded-for is ignored.

# DB port published by docker compose (defaults to 5433 to avoid conflicts).
# DB_PORT=5433

# --- Billing (Dodo Payments) ---
# Test mode only until the reviewer explicitly enables live mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Must be exactly "true" AND NODE_ENV=production before live mode is allowed.
ALLOW_LIVE_PAYMENTS=false
# Server-only secrets. Never put these in the desktop app.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_PRO=
# Base64 PKCS#8 ECDSA P-256 key for signing entitlement snapshots (server only).
ENTITLEMENT_SIGNING_KEY=
ENTITLEMENT_SIGNING_KID=k1
# Public HTTPS base used for the checkout return bounce page.
API_PUBLIC_URL=http://localhost:8787
