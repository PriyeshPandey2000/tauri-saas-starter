{
  "name": "desktop-app-boilerplate",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "typescript": ">=6.0.3 <6.1.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run lint:arch && pnpm run check-vendor-imports && pnpm run verify:capabilities",
    "lint:arch": "eslint --config packages/config/eslint.config.js apps/desktop/src packages/shared/src apps/api/src",
    "check-vendor-imports": "node scripts/check-vendor-imports.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "verify:capabilities": "node scripts/check-capabilities.mjs",
    "check:cycles": "madge --circular --extensions ts,tsx apps/desktop/src packages/shared/src",
    "verify:prerelease": "node scripts/check-prerelease.mjs",
    "verify:feature-boundaries": "node scripts/check-feature-boundaries.mjs",
    "verify:guards": "node scripts/check-guards.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:suggest": "node scripts/version.mjs suggest",
    "changelog": "node scripts/changelog.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "audit:rust": "cargo audit -f apps/desktop/src-tauri/Cargo.lock --ignore RUSTSEC-2026-0367 --ignore RUSTSEC-2026-0368 --ignore RUSTSEC-2026-0369 --ignore RUSTSEC-2023-0071"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@config/eslint-config": "workspace:*",
    "eslint": "10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "turbo": "^2.11.9",
    "typescript-eslint": "8.71.2"
  }
}
