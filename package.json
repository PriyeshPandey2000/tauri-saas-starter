{
  "name": "desktop-app-boilerplate",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "typescript": ">=6.0.3 <6.1.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:arch": "eslint --config packages/config/eslint.config.js apps/desktop packages --ext .ts,.tsx",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@config/eslint-config": "workspace:*",
    "eslint": "10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript-eslint": "8.71.2"
  }
}
