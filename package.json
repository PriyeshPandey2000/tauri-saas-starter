{
  "name": "desktop-app-boilerplate",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "typescript": ">=6.0.3 <6.1.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run lint:arch && pnpm run check-vendor-imports",
    "lint:arch": "eslint --config packages/config/eslint.config.js apps/desktop/src packages/shared/src apps/api/src",
    "check-vendor-imports": "node scripts/check-vendor-imports.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@config/eslint-config": "workspace:*",
    "eslint": "10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript-eslint": "8.71.2"
  }
}
